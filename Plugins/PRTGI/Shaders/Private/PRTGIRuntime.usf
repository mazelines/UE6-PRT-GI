#include "/Engine/Public/Platform.ush"
StructuredBuffer<float4> Triangles;
StructuredBuffer<float4> Nodes;
StructuredBuffer<float4> Materials;
StructuredBuffer<float4> Lights;
StructuredBuffer<float4> Probes;
RWStructuredBuffer<float4> OutSH;
uint NodeCount;
uint LightCount;
uint ProbeOffset;
uint ProbeCount;
uint RayCount;
uint BounceCount;
StructuredBuffer<float4> SurfacePool;
StructuredBuffer<uint> ActiveSlots;
StructuredBuffer<float4> SurfelBindings;
StructuredBuffer<float4> PreviousIrradiance;
RWStructuredBuffer<float4> NextIrradiance;
uint CacheEnabled;
uint CacheOffset;
uint CacheActiveCount;
uint CacheRayCount;
uint CacheIteration;
float CacheRelaxation;
RWStructuredBuffer<float4> TransportQueries;
uint ReuseTransport;
uint QueryStride;
uint RegionalReuse;
uint HasChangedBounds;
float3 ChangedMin;
float3 ChangedMax;
StructuredBuffer<float4> OldQueries;
StructuredBuffer<float4> OldSurfacePool;
StructuredBuffer<uint> OldToNewTriangles;
RWStructuredBuffer<uint> QueryStats;
float3 AnalyticEnvironment;
uint RecordIrradiance;
uint ReuseIrradiance;
uint SurfaceCapacity;
uint TriangleCount;
StructuredBuffer<float4> OldIrradianceHistory;
RWStructuredBuffer<float4> IrradianceHistory;
RWStructuredBuffer<uint> SourceDirty;
RWStructuredBuffer<uint> DirtyTriangles;
groupshared uint DirtyGroupFlag;

bool BoxHit(float3 O, float3 D, float3 Min, float3 Max, float Limit)
{
    float Lo=0,Hi=Limit;
    [unroll] for(uint Axis=0;Axis<3;++Axis)
    {
        if(abs(D[Axis])<1.e-8) { if(O[Axis]<Min[Axis] || O[Axis]>Max[Axis]) return false; }
        else { float A=(Min[Axis]-O[Axis])/D[Axis],B=(Max[Axis]-O[Axis])/D[Axis]; Lo=max(Lo,min(A,B));Hi=min(Hi,max(A,B)); }
    }
    return Hi>=Lo;
}
int TraceWithAmbiguity(float3 O,float3 D,inout float Distance,out float2 Bary,bool Shadow,out float Ambiguous)
{
    int Hit=-1; Bary=0;Ambiguous=0;
    uint Node=0;
    [loop] while(Node<NodeCount)
    {
        float4 Min=Nodes[Node*2],Max=Nodes[Node*2+1];
        if(!BoxHit(O,D,Min.xyz,Max.xyz,Distance)) { Node=Min.w<0?(uint)Max.w:Node+1;continue; }
        if(Min.w<0) { ++Node;continue; }
        [loop] for(uint T=(uint)Min.w;T<(uint)(Min.w+Max.w);++T)
        {
            float4 A=Triangles[T*3]; if(Shadow && A.w==0)continue;
            float3 E1=Triangles[T*3+1].xyz,E2=Triangles[T*3+2].xyz,P=cross(D,E2);
            float Det=dot(E1,P);if(abs(Det)<1.e-8)continue;
            float Inv=rcp(Det);float3 Delta=O-A.xyz;
            float U=dot(Delta,P)*Inv;if(U<0||U>1)continue;
            float3 Q=cross(Delta,E1);float V=dot(D,Q)*Inv;if(V<0||U+V>1)continue;
            float TDist=dot(E2,Q)*Inv;
            float TieTolerance=.001+1.e-6*abs(Distance);
            if(TDist>.002 && Hit>=0 && abs(TDist-Distance)<=TieTolerance)Ambiguous=1;
            else if(TDist>.002 && TDist<Distance)Ambiguous=0;
            if(TDist>.002 && TDist<Distance) { Distance=TDist;Bary=float2(U,V);Hit=T;if(Shadow)return Hit; }
        }
        ++Node;
    }
    return Hit;
}
int Trace(float3 O,float3 D,inout float Distance,out float2 Bary,bool Shadow)
{
    float Unused;return TraceWithAmbiguity(O,D,Distance,Bary,Shadow,Unused);
}
uint Hash(uint X) { X^=X>>16;X*=0x7feb352d;X^=X>>15;X*=0x846ca68b;return X^(X>>16); }
float Rand(inout uint Seed) { Seed=Hash(Seed);return (Seed>>8)*(1.0/16777216.0); }
float3 CosineDirection(float3 N,inout uint Seed)
{
    float U=Rand(Seed),A=6.28318530718*Rand(Seed);
    float3 T=normalize(cross(abs(N.z)<.99?float3(0,0,1):float3(0,1,0),N)),B=cross(N,T);
    return sqrt(U)*(cos(A)*T+sin(A)*B)+sqrt(1-U)*N;
}
float3 DirectAt(float3 P,float3 N,float3 Ng,float Bias)
{
    float3 Direct=0;
        [loop] for(uint L=0;L<LightCount;++L)
        {
            float4 Pos=Lights[L*2],Color=Lights[L*2+1];float3 ToLight=Pos.xyz;float Limit=1.e7,Attenuation=1;
            if(Pos.w>0)
            {
                ToLight=Pos.xyz-P;float D2=dot(ToLight,ToLight);Limit=sqrt(D2);
                ToLight/=max(Limit,.001);
                float Fade=saturate(1-pow(Limit/max(Color.w,.001),4));
                // World units are cm. Color is point-light luminous intensity
                // in candela, including indirect intensity and temperature.
                Attenuation=Fade*Fade/max(D2*.0001,.0001);
            }
            float Cos=dot(Ng,ToLight)>0?max(0,dot(N,ToLight)):0;
            if(Cos>0 && Attenuation>0)
            {
                float2 Unused;float ShadowDistance=max(0,Limit-Bias);
                if(Trace(P,ToLight,ShadowDistance,Unused,true)<0) Direct+=Color.rgb*(Cos*Attenuation);
            }
        }
    return Direct;
}
float3 CachedIrradiance(uint Hit,float2 Bary)
{
    float4 Binding=SurfelBindings[Hit];uint N=(uint)Binding.y;
    if(N==0)return 0;
    float2 UV=Bary*N;int2 Cell=int2(floor(UV));float3 Sum=0;float Weight=0;
    // Compact smooth weights in the hit triangle's barycentric lattice.
    // Exact triangle ownership avoids blending nearby walls or other instances.
    [unroll]for(int Y=-1;Y<=1;++Y)[unroll]for(int X=-1;X<=1;++X)
    {
        int2 C=Cell+int2(X,Y);
        if(any(C<0) || C.x+C.y>=int(N))continue;
        [unroll]for(uint Upper=0;Upper<2;++Upper)
        {
            if(Upper!=0 && C.x+C.y>=int(N)-1)continue;
            float2 Delta=UV-(float2(C)+(Upper!=0?2.0/3.0:1.0/3.0));
            float W=saturate(1-dot(Delta,Delta));W*=W;
            uint Local=C.y*(2*N-C.y)+2*C.x+Upper;
            Sum+=PreviousIrradiance[(uint)Binding.x+Local].rgb*W;Weight+=W;
        }
    }
    return Weight>1.e-8?Sum/Weight:0;
}
float3 Path(float3 O,float3 D,inout uint Seed,out float Backface)
{
    float3 Sum=0,Throughput=1;Backface=0;
    [loop] for(uint Bounce=0;Bounce<BounceCount;++Bounce)
    {
        float Distance=6400;float2 Bary;int Hit=Trace(O,D,Distance,Bary,false);if(Hit<0)break;
        uint Sample=(uint)min(7,floor(Bary.y*8))*8+(uint)min(7,floor(Bary.x*8));
        float3 Rho=Materials[Hit*128+Sample*2].xyz;
        float3 N=Materials[Hit*128+Sample*2+1].xyz;
        float3 Ng=normalize(cross(Triangles[Hit*3+1].xyz,Triangles[Hit*3+2].xyz));
        // Winding may reverse under mirrored instance transforms. Authored
        // shading normals determine the outward side of opaque surfaces.
        if(dot(Ng,N)<0)Ng=-Ng;
        if(dot(Ng,D)>=0) { if(Bounce==0)Backface=1;break; }
        float3 P=O+D*Distance;float Bias=max(.02,4*1.1920929e-7*max(max(abs(P.x),abs(P.y)),abs(P.z)));
        P+=Ng*Bias;
        float3 Direct=DirectAt(P,N,Ng,Bias);
        if(CacheEnabled!=0)return Rho*(Direct+CachedIrradiance(Hit,Bary))/3.14159265359;
        Sum+=Throughput*Rho*(Direct/3.14159265359);
        Throughput*=Rho;
        if(Bounce>=3 && max(Throughput.r,max(Throughput.g,Throughput.b))<.01)break;
        D=CosineDirection(N,Seed);if(dot(D,Ng)<=0)break;O=P;
    }
    return Sum;
}
groupshared float3 Reduction[64*9];
groupshared float Backfaces[64];
[numthreads(64,1,1)]
void RuntimeCS(uint3 Group:SV_GroupID,uint Lane:SV_GroupIndex)
{
    uint Probe=ProbeOffset+Group.x;if(Probe>=ProbeCount)return;
    float3 Sum[9];[unroll]for(uint C=0;C<9;++C)Sum[C]=0;
    float Rejected=0;
    [loop]for(uint Ray=Lane;Ray<RayCount;Ray+=64)
    {
        // Stable deterministic samples: changes do not inject temporal noise.
        float Z=1-2*(Ray+.5)/RayCount,A=2.399963229728653*Ray;
        float R=sqrt(max(0,1-Z*Z));float3 D=float3(R*cos(A),R*sin(A),Z);
        uint Seed=Hash(Probe*8191+Ray+1);float Backface;
        float3 L=Path(Probes[Probe].xyz,D,Seed,Backface);Rejected+=Backface;
        float Y[9];
        Y[0]=.2820947918;Y[1]=.4886025119*D.y;Y[2]=.4886025119*D.z;Y[3]=.4886025119*D.x;
        Y[4]=1.0925484306*D.x*D.y;Y[5]=1.0925484306*D.y*D.z;Y[6]=.3153915653*(3*D.z*D.z-1);
        Y[7]=1.0925484306*D.x*D.z;Y[8]=.5462742153*(D.x*D.x-D.y*D.y);
        [unroll]for(uint C=0;C<9;++C)Sum[C]+=L*Y[C];
    }
    [unroll]for(uint C=0;C<9;++C)Reduction[Lane*9+C]=Sum[C];Backfaces[Lane]=Rejected;
    GroupMemoryBarrierWithGroupSync();
    [unroll]for(uint Step=32;Step>0;Step>>=1)
    {
        if(Lane<Step) { [unroll]for(uint C=0;C<9;++C)Reduction[Lane*9+C]+=Reduction[(Lane+Step)*9+C];Backfaces[Lane]+=Backfaces[Lane+Step]; }
        GroupMemoryBarrierWithGroupSync();
    }
    if(Lane==0) [unroll]for(uint C=0;C<9;++C)
    {
        float Band=C==0?3.14159265359:(C<4?2.09439510239:.78539816339);
        OutSH[Probe*9+C]=float4(Reduction[C]*(12.56637061436*Band/RayCount),C==0?(Backfaces[0]>.25*RayCount?-1:1):0);
    }
}

bool ReuseOldQuery(uint Slot,uint Query,float3 Origin,float3 Direction)
{
    if(any(OldSurfacePool[Slot*4].xyz!=SurfacePool[Slot*4].xyz) ||
       any(OldSurfacePool[Slot*4+1].xyz!=SurfacePool[Slot*4+1].xyz) ||
       any(OldSurfacePool[Slot*4+3].xyz!=SurfacePool[Slot*4+3].xyz))return false;
    float4 Record=OldQueries[Query],UV=OldQueries[Query+1];int Hit=int(Record.w);
    // Negative distance denotes a rejected direction, invariant for this normal.
    if(HasChangedBounds!=0 && UV.z>=0 && BoxHit(Origin,Direction,ChangedMin,ChangedMax,UV.z))return false;
    if(Hit>=0)
    {
        // Equal/near-equal hits can select a different primitive after BVH
        // reordering. Re-evaluate these even outside the changed bounds.
        if(HasChangedBounds!=0 && UV.w>0)return false;
        uint Mapped=OldToNewTriangles[Hit];if(Mapped==0xffffffff)return false;
        float3 P=OldQueries[Query+2].xyz;
        if(HasChangedBounds!=0)[loop]for(uint L=0;L<LightCount;++L)
        {
            float4 Light=Lights[L*2];float3 D=Light.xyz;float Limit=1.e7;
            if(Light.w>0){D-=P;Limit=length(D);D/=max(Limit,.001);}
            // Conservatively check every light, including currently occluded rays.
            // A moved blocker can change visibility far outside the local bounds.
            if(BoxHit(P,D,ChangedMin,ChangedMax,Limit))return false;
        }
        Record.w=float(Mapped);
    }
    TransportQueries[Query]=Record;TransportQueries[Query+1]=UV;
    TransportQueries[Query+2]=OldQueries[Query+2];return true;
}

// Jacobi sweep: all batches read the same previous buffer. Swap only after
// the entire active set is complete; no in-place radiance propagation.
[numthreads(64,1,1)]
void CacheCS(uint3 Group:SV_GroupID,uint Lane:SV_GroupIndex)
{
    uint Active=CacheOffset+Group.x;if(Active>=CacheActiveCount)return;
    uint Slot=ActiveSlots[Active];float3 P=SurfacePool[Slot*4].xyz;
    if(RecordIrradiance!=0)
    {
        if(Lane==0)DirtyGroupFlag=0;
        GroupMemoryBarrierWithGroupSync();
    }
    if(ReuseIrradiance!=0 && CacheIteration>0)
    {
        if(Lane==0)DirtyGroupFlag=SourceDirty[Active] |
            uint(CacheRelaxation<1 && any(PreviousIrradiance[Slot].rgb!=OldIrradianceHistory[(CacheIteration-1)*SurfaceCapacity+Slot].rgb));
        GroupMemoryBarrierWithGroupSync();
        // Triangle-level masks conservatively include every interpolation seed,
        // including changes far outside the edited object's geometric bounds.
        [loop]for(uint Ray=Lane;Ray<CacheRayCount;Ray+=64)
        {
            int Hit=int(TransportQueries[(Active*CacheRayCount+Ray)*QueryStride].w);
            if(Hit>=0 && DirtyTriangles[Hit]!=0)InterlockedOr(DirtyGroupFlag,1);
        }
        GroupMemoryBarrierWithGroupSync();
        if(DirtyGroupFlag==0)
        {
            if(Lane==0)
            {
                float4 Value=OldIrradianceHistory[CacheIteration*SurfaceCapacity+Slot];
                NextIrradiance[Slot]=Value;IrradianceHistory[CacheIteration*SurfaceCapacity+Slot]=Value;
                InterlockedAdd(QueryStats[2],1);
            }
            return;
        }
    }
    float3 N=SurfacePool[Slot*4+1].xyz,Ng=SurfacePool[Slot*4+3].xyz;
    float Bias=max(.02,4*1.1920929e-7*max(max(abs(P.x),abs(P.y)),abs(P.z)));
    float3 Origin=P+Ng*Bias,Sum=0;
    [loop]for(uint Ray=Lane;Ray<CacheRayCount;Ray+=64)
    {
        // Dense active indices, not sparse surface slots. The immutable scene
        // and deterministic samples make these geometric/light queries invariant
        // across Jacobi sweeps. Irradiance is still gathered anew every sweep.
        uint Query=(Active*CacheRayCount+Ray)*QueryStride;
        float3 D=0;
        if(CacheIteration==0 || ReuseTransport==0){uint Seed=Hash(Slot*8191+Ray+1);D=CosineDirection(N,Seed);}
        bool Reused=false;
        if(ReuseTransport!=0 && RegionalReuse!=0 && CacheIteration==0)
            Reused=ReuseOldQuery(Slot,Query,Origin,D);
        if(QueryStride==3 && CacheIteration==0)InterlockedAdd(QueryStats[Reused?0:1],1);
        if(RecordIrradiance!=0 && CacheIteration==0 && !Reused)InterlockedOr(DirtyGroupFlag,1);
        if(ReuseTransport!=0 && (CacheIteration>0 || Reused))
        {
            float4 Record=TransportQueries[Query];int Hit=int(Record.w);
            if(Hit<0){Sum+=Record.rgb;continue;}
            float2 Bary=TransportQueries[Query+1].xy;
            uint Sample=(uint)min(7,floor(Bary.y*8))*8+(uint)min(7,floor(Bary.x*8));
            Sum+=Materials[Hit*128+Sample*2].xyz*(Record.rgb+CachedIrradiance(Hit,Bary));
            continue;
        }
        if(ReuseTransport!=0)
        {
            // Rejected directions/backfaces and misses must also overwrite rows.
            TransportQueries[Query]=float4(0,0,0,-1);
            TransportQueries[Query+1]=float4(0,0,-1,0);
            if(QueryStride==3)TransportQueries[Query+2]=0;
        }
        // Fixed samples define a deterministic transport operator. Relaxation
        // damps the iteration, not stochastic frame-to-frame noise.
        if(dot(D,Ng)<=0)continue;
        float Distance=6400;float2 Bary;float Ambiguous;
        int Hit=TraceWithAmbiguity(Origin,D,Distance,Bary,false,Ambiguous);
        if(ReuseTransport!=0)TransportQueries[Query+1]=float4(Bary,Distance,Ambiguous);
        if(Hit<0)
        {
            float3 Environment=3.14159265359*AnalyticEnvironment;
            if(ReuseTransport!=0)TransportQueries[Query]=float4(Environment,-1);
            Sum+=Environment;continue;
        }
        uint Sample=(uint)min(7,floor(Bary.y*8))*8+(uint)min(7,floor(Bary.x*8));
        float3 Rho=Materials[Hit*128+Sample*2].xyz,HN=Materials[Hit*128+Sample*2+1].xyz;
        float3 HNg=normalize(cross(Triangles[Hit*3+1].xyz,Triangles[Hit*3+2].xyz));
        if(dot(HNg,HN)<0)HNg=-HNg;
        if(dot(HNg,D)>=0)continue;
        float3 HP=Origin+D*Distance;
        float HBias=max(.02,4*1.1920929e-7*max(max(abs(HP.x),abs(HP.y)),abs(HP.z)));
        // pi from cosine-PDF integration cancels the hit's Lambert 1/pi.
        float3 Direct=DirectAt(HP+HNg*HBias,HN,HNg,HBias);
        if(ReuseTransport!=0)
        {
            TransportQueries[Query]=float4(Direct,float(Hit));
            TransportQueries[Query+1]=float4(Bary,Distance,Ambiguous);
            if(QueryStride==3)TransportQueries[Query+2]=float4(HP+HNg*HBias,HBias);
        }
        Sum+=Rho*(Direct+CachedIrradiance(Hit,Bary));
    }
    Reduction[Lane*9]=Sum;GroupMemoryBarrierWithGroupSync();
    [unroll]for(uint Step=32;Step>0;Step>>=1)
    {
        if(Lane<Step)Reduction[Lane*9]+=Reduction[(Lane+Step)*9];
        GroupMemoryBarrierWithGroupSync();
    }
    if(Lane==0)
    {
        float4 Value=float4(lerp(PreviousIrradiance[Slot].rgb,Reduction[0]/CacheRayCount,CacheRelaxation),CacheIteration+1);
        NextIrradiance[Slot]=Value;
        if(RecordIrradiance!=0)
        {
            if(CacheIteration==0)SourceDirty[Active]=DirtyGroupFlag;
            IrradianceHistory[CacheIteration*SurfaceCapacity+Slot]=Value;
            InterlockedAdd(QueryStats[3],1);
        }
    }
}

// Executed only after all batches of a sweep have finished. The next sweep
// reads these flags; no batch observes partially updated dependencies.
[numthreads(64,1,1)]
void DirtyTrianglesCS(uint3 Group:SV_GroupID,uint Lane:SV_GroupIndex)
{
    uint Triangle=Group.x+Group.y*65535;if(Triangle>=TriangleCount)return;
    if(Lane==0)DirtyGroupFlag=0;
    GroupMemoryBarrierWithGroupSync();
    float4 Binding=SurfelBindings[Triangle];
    [loop]for(uint I=Lane;I<uint(Binding.z);I+=64)
    {
        uint Slot=uint(Binding.x)+I;
        if(any(NextIrradiance[Slot].rgb!=OldIrradianceHistory[CacheIteration*SurfaceCapacity+Slot].rgb))InterlockedOr(DirtyGroupFlag,1);
    }
    GroupMemoryBarrierWithGroupSync();
    if(Lane==0)DirtyTriangles[Triangle]=DirtyGroupFlag;
}
